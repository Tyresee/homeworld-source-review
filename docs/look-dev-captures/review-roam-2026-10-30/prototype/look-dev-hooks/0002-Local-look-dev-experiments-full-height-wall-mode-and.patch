diff --git a/public/js/home-room-expansion.js b/public/js/home-room-expansion.js
index 5b40eaa..96072cc 100644
--- a/public/js/home-room-expansion.js
+++ b/public/js/home-room-expansion.js
@@ -131,15 +131,15 @@ export function createRoomExpansion({ rooms = 'starter', tier, maps = {}, includ
     for (const [x, yy, w] of [[-.28, y - .35, .3], [.2, y - .48, .42]]) local(new THREE.SphereGeometry(1, 12, 8), '#a7cba4', [x, yy, -.02]).scale.set(w, .26, .01);
   }
   // LOCAL PROTOTYPE: globalThis.__WALLMODE = 'cut' | 'focus'; __FOCUS_RECT = {minX,maxX,minZ,maxZ}
-  const WALLMODE = () => ['cut','focus'].includes(globalThis.__WALLMODE) ? globalThis.__WALLMODE : null;
+  const WALLMODE = () => ['cut','focus','full'].includes(globalThis.__WALLMODE) ? globalThis.__WALLMODE : null;
   const CUT_H = globalThis.__CUT_H ?? 1.05; let forceFull = false;
   function lowWall(length, center, axis, color, height = PARTITION_HEIGHT) {
-    if (WALLMODE()) height = forceFull ? WALL_HEIGHT : CUT_H;
+    if (WALLMODE()) height = (forceFull || WALLMODE()==='full') ? WALL_HEIGHT : CUT_H;
     const size = axis === 'x' ? [length, height, .17] : [.17, height, length];
     const m = box(size, [center[0], height / 2 + .06, center[2]], color, 'walls', .03, { roughness: .86 });
     if (WALLMODE()) {
       const capSize = axis === 'x' ? [length, .04, .19] : [.19, .04, length];
-      const cap = box(capSize, [center[0], height + .06 + .02, center[2]], forceFull ? shellColor('wallCap', PALETTE.trim) : (globalThis.__CUT_COLOR ?? '#4a3f37'), 'border', .004);
+      const cap = box(capSize, [center[0], height + .06 + .02, center[2]], (forceFull||WALLMODE()==='full') ? shellColor('wallCap', PALETTE.trim) : (globalThis.__CUT_COLOR ?? '#4a3f37'), 'border', .004);
       cap.castShadow = false;
     }
     return m;
